<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Active Navigation Map (Full Screen) -->
    <fragment
        android:id="@+id/activeRideMapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rideActionCard" />

    <!-- Top Floating Turn-by-Turn Banner (Uber Style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bannerNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivNavDirection"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_navigation"
                app:tint="#22C55E"
                android:contentDescription="Dirección" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNavNextInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En 200 m gira a la derecha"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNavStreetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hacia la ubicación del pasajero"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNavETA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 min"
                android:textColor="#22C55E"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating In-App Camera Mode Toggle Button (3D / 2D / Overview) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnCameraMode"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="#000000"
        app:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerNavigation">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivCameraIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_navigation"
                app:tint="#22C55E"
                android:contentDescription="Cámara" />

            <TextView
                android:id="@+id/tvCameraModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="3D CONDUCCIÓN"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Voice Guidance Toggle Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnVoiceToggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="#000000"
        app:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerNavigation">

        <ImageView
            android:id="@+id/ivVoiceIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_phone"
            app:tint="#22C55E"
            android:contentDescription="Voz" />
    </androidx.cardview.widget.CardView>

    <!-- Floating Re-Center Navigation Button (Shown when user drags map) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnRecenter"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="23dp"
        app:cardBackgroundColor="#2563EB"
        app:cardElevation="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rideActionCard">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_navigation"
                app:tint="#FFFFFF"
                android:contentDescription="Recentrar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="RE-CENTRAR RUTA"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Sheet Card with Passenger & Ride Details -->
    <LinearLayout
        android:id="@+id/rideActionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Passenger Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivPassengerPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:tint="#64748B"
                    android:contentDescription="Pasajero" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPassengerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pasajero"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPassengerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.0 ★"
                        android:textColor="#F59E0B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="• Español"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Communication Action Buttons -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnCallPassenger"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="#0F172A"
                    android:contentDescription="Llamar" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnChatPassenger"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat"
                    app:tint="#0F172A"
                    android:contentDescription="Mensaje" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Address & Details -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#F1F5F9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCurrentStageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOGIENDO EN"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentStageAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dirección actual"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Proximity Geofence Indicator -->
            <TextView
                android:id="@+id/tvGpsProximity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📍 GPS: Verificando proximidad..."
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main State Action Button (Uber Slide/Click Button) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnRideAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#276EF1"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvRideActionText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="LLEGUE AL PUNTO DE ENCUENTRO"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- Botón Cancelar Viaje por Emergencia / Incidencia -->
        <TextView
            android:id="@+id/btnCancelActiveRide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="⚠️ Cancelar carrera por emergencia"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
