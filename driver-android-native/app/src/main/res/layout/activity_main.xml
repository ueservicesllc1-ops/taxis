<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.MainActivity">

    <!-- ======================================= -->
    <!-- MAIN CONTENT (UBER DRIVER CLONE)        -->
    <!-- ======================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A">

        <!-- Full-Screen Google Map -->
        <fragment
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ============================= -->
        <!-- TOP FLOATING BAR              -->
        <!-- ============================= -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Hamburger ☰ Button (White Circle) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnOpenMenu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="25dp"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Menú"
                    app:tint="#000000" />
            </androidx.cardview.widget.CardView>

            <!-- Black Earnings Pill — center, grows to fill -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnEarningsPill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="23dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTodayEarnings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Profile Photo (White Circle) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnProfilePhoto"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="25dp"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_taxi_logo"
                    android:contentDescription="Perfil" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ============================= -->
        <!-- "IR" BIG BLUE CIRCLE BUTTON   -->
        <!-- Uber uses "IR", not "INICIAR" -->
        <!-- ============================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnGoOnline"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#276EF1"
            app:cardCornerRadius="47dp"
            app:cardElevation="12dp"
            app:layout_constraintBottom_toTopOf="@id/bottomSheet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGoOnlineText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="IR"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeStepGranularity="1sp" />

        </androidx.cardview.widget.CardView>

        <!-- ============================= -->
        <!-- WHITE BOTTOM SHEET            -->
        <!-- ============================= -->
        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp"
            android:elevation="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Drag handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="#CBD5E1" />

            <!-- Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left settings icon -->
                <ImageView
                    android:id="@+id/btnSheetSettings"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Ajustes"
                    app:tint="#0F172A" />

                <!-- Center status text -->
                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Estás desconectado"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Right list icon -->
                <ImageView
                    android:id="@+id/btnSheetList"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Lista"
                    app:tint="#0F172A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Presiona IR para comenzar a recibir carreras"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ======================================= -->
    <!-- UBER NAVIGATION DRAWER                  -->
    <!-- ======================================= -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0F172A"
        app:headerLayout="@layout/nav_header_uber"
        app:menu="@menu/menu_uber_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
