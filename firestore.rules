rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPERS DE AUTENTICACIÓN Y ROLES (FASE 5C)
    // ============================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function getUserRole() {
      return isAuthenticated() && ('role' in request.auth.token) ? request.auth.token.role : 'driver';
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }
    
    function isDispatcher() {
      return isAuthenticated() && (
        request.auth.token.role == 'dispatcher' ||
        request.auth.token.dispatcher == true
      );
    }
    
    function isSupervisor() {
      return isAuthenticated() && (
        request.auth.token.role == 'supervisor' ||
        request.auth.token.supervisor == true
      );
    }
    
    function isDriver() {
      return isAuthenticated() && (
        request.auth.token.role == 'driver' ||
        (!('role' in request.auth.token) && !isAdmin() && !isDispatcher() && !isSupervisor())
      );
    }
    
    function isStaff() {
      return isAdmin() || isDispatcher() || isSupervisor();
    }
    
    // ============================================
    // 1. COLECCIÓN RIDES (CARRERAS)
    // ============================================
    // Autoridad de Escritura: Backend Admin SDK EXCLUSIVAMENTE.
    // Ningún cliente (Web/Android/SDK directo) puede crear, modificar ni eliminar carreras.
    match /rides/{rideId} {
      // Lectura: Staff tiene acceso global. Conductor solo a viajes asignados a él.
      allow read: if isStaff() || (
        isDriver() && (
          resource.data.driverId == request.auth.uid ||
          (resource.data.assignedDriver != null && resource.data.assignedDriver.id == request.auth.uid)
        )
      );
      
      // Bloqueo total de escritura directa desde clientes
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // ============================================
    // 2. COLECCIÓN DRIVERS (CONDUCTORES Y TELEMETRÍA)
    // ============================================
    match /drivers/{driverId} {
      // Lectura: Staff puede leer toda la flota. Conductor solo puede leer su propio perfil.
      allow read: if isStaff() || (isAuthenticated() && request.auth.uid == driverId);
      
      // Creación: Staff o auto-registro del propio conductor (sin permitir escalación de rol)
      allow create: if isStaff() || (
        isAuthenticated() && 
        request.auth.uid == driverId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'driver')
      );
      
      // Actualización: 
      // - Staff puede actualizar perfiles.
      // - Conductor SOLO puede actualizar su propio documento y NO puede alterar campos protegidos.
      allow update: if isStaff() || (
        isAuthenticated() && 
        request.auth.uid == driverId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'earnings',
          'balance',
          'driverEarnings',
          'adminApproved',
          'totalEarnings'
        ])
      );
      
      // Eliminación: Solo Administrador
      allow delete: if isAdmin();
    }
    
    // ============================================
    // 3. COLECCIÓN DRIVER_EARNINGS Y EARNINGS (FINANZAS)
    // ============================================
    // Autoridad Financiera: Backend Admin SDK EXCLUSIVAMENTE.
    match /driver_earnings/{earningId} {
      allow read: if isStaff() || (
        isAuthenticated() && (
          resource.data.driverId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update, delete: if false;
    }
    
    match /earnings/{earningId} {
      allow read: if isStaff() || (
        isAuthenticated() && (
          resource.data.driverId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update, delete: if false;
    }
    
    // ============================================
    // 4. COLECCIÓN USERS (USUARIOS Y PERFILES)
    // ============================================
    match /users/{userId} {
      allow read: if isStaff() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'driver')
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'claims', 'permissions'])
      );
      allow delete: if isAdmin();
    }
    
    // ============================================
    // 5. COLECCIÓN COMPANIES (EMPRESAS / CONFIGURACIÓN)
    // ============================================
    match /companies/{companyId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    
    // ============================================
    // 6. REGLA POR DEFECTO: DENY BY DEFAULT
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
